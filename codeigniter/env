#--------------------------------------------------------------------
# Kollus 동영상 플레이어 설정
#--------------------------------------------------------------------
# Kollus 콘솔 > 사용자 키 메뉴에서 발급받은 값을 입력하세요. (https://c-kr.kollus.com/service-account/custom-key)
# KOLLUS_SECURITY_KEY=
# KOLLUS_CUSTOM_KEY=
# Kollus VOD 콘솔 > 서비스 계정 > API 에서 발급 (https://c-kr.kollus.com/service-account/api-service)
# KOLLUS_ACCESS_TOKEN=
# KOLLUS_PLAYER_URL=https://v.kr.kollus.com/
# JWT 만료 시간(초).
# KOLLUS_TOKEN_EXPIRE_SECONDS=300
# 다음 회차 연속 재생 샘플 미디어 콘텐츠 키 (콤마 구분 목록, 예: mck1,mck2 — 공백을 넣으려면 값 전체를 큰따옴표로 감쌀 것)
# KOLLUS_NEXT_EPISODE_MCKS=
# 멀티 DRM 재생 전용 Kollus 계정 키 (일반 KOLLUS_SECURITY_KEY/KOLLUS_CUSTOM_KEY와 별도 계정)
# KOLLUS_MULTIDRM_SECURITY_KEY=
# KOLLUS_MULTIDRM_CUSTOM_KEY=
# 멀티 DRM(DoveRunner) 설정 — DoveRunner 콘솔에서 발급
# KOLLUS_DOVERUNNER_ACCESS_KEY=
# KOLLUS_DOVERUNNER_SITE_KEY=
# KOLLUS_DOVERUNNER_SITE_ID=
# KOLLUS_DOVERUNNER_IV=0123456789abcdef
# KOLLUS_DOVERUNNER_LICENSE_URL=https://drm-license.doverunner.com/ri/licenseManager.do
# KOLLUS_DOVERUNNER_CERTIFICATE_URL=https://drm-license.doverunner.com/ri/fpsKeyManager.do
